<Window x:Class="GitHubBackup.App.Views.DiscoveryReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GitHubBackup.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DiscoveryReviewViewModel}"
        Title="Discovered repositories" Height="480" Width="1100"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.AutomationId="DiscoveryReviewWindow">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand, Mode=OneWay}" />
    </Window.InputBindings>
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Text="Choose what happens to each repository, then apply. Cancel stops the whole run without changing anything." />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasNewRows, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Content="Add all"
                        Command="{Binding AddAllCommand, Mode=OneWay}"
                        Padding="8,2" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="AddAllButton" />
                <Button Content="Skip all"
                        Command="{Binding SkipAllCommand, Mode=OneWay}"
                        Padding="8,2" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="SkipAllButton" />
                <Button Content="Exclude all"
                        Command="{Binding ExcludeAllCommand, Mode=OneWay}"
                        Padding="8,2" Margin="0,0,16,0"
                        AutomationProperties.AutomationId="ExcludeAllButton" />
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasRenamedRows, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Content="a) Rename all archive folders"
                        Command="{Binding RenameAllArchiveFoldersCommand, Mode=OneWay}"
                        Padding="8,2" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="RenameAllArchiveFoldersButton" />
                <Button Content="b) Keep all archive folders"
                        Command="{Binding KeepAllArchiveFoldersCommand, Mode=OneWay}"
                        Padding="8,2" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="KeepAllArchiveFoldersButton" />
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{Binding ApplyText, Mode=OneWay}"
                    Command="{Binding ApplyCommand, Mode=OneWay}"
                    MinWidth="80" Padding="8,2" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="ApplyDiscoveryButton" />
            <Button Content="Cancel run"
                    Command="{Binding CancelCommand, Mode=OneWay}"
                    MinWidth="80" Padding="8,2"
                    AutomationProperties.AutomationId="CancelDiscoveryButton" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Rows, Mode=OneWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  AutomationProperties.AutomationId="DiscoveryTable">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind, Mode=OneWay}" />
                <DataGridTextColumn Header="Repository" Binding="{Binding Repository, Mode=OneWay}" />
                <DataGridTextColumn Header="Account" Binding="{Binding Account, Mode=OneWay}" />
                <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" />
                <DataGridTemplateColumn Header="Action" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding Mode=OneWay}" Focusable="False">
                                <ContentControl.Resources>
                                    <DataTemplate DataType="{x:Type vm:NewDiscoveryRowViewModel}">
                                        <ComboBox ItemsSource="{Binding Choices, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Choice, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="NewRepositoryAction" />
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:RenamedDiscoveryRowViewModel}">
                                        <ComboBox ItemsSource="{Binding Variants, Mode=OneWay}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Variant, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanChooseVariant, Mode=OneWay}"
                                                  AutomationProperties.AutomationId="RenameVariant" />
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:DiscoveryRowViewModel}">
                                        <TextBlock Text="No action" Foreground="Gray" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </ContentControl.Resources>
                            </ContentControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Branch" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding Mode=OneWay}" Focusable="False">
                                <ContentControl.Resources>
                                    <DataTemplate DataType="{x:Type vm:NewDiscoveryRowViewModel}">
                                        <TextBox Text="{Binding Branch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsAdded, Mode=OneWay}"
                                                 ToolTip="{Binding BranchError, Mode=OneWay}"
                                                 AutomationProperties.AutomationId="NewRepositoryBranch">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBranchError, Mode=OneWay}" Value="True">
                                                            <Setter Property="BorderBrush" Value="Red" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:DiscoveryRowViewModel}">
                                        <Grid />
                                    </DataTemplate>
                                </ContentControl.Resources>
                            </ContentControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Archive folder" MinWidth="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding Mode=OneWay}" Focusable="False">
                                <ContentControl.Resources>
                                    <DataTemplate DataType="{x:Type vm:NewDiscoveryRowViewModel}">
                                        <TextBox Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsAdded, Mode=OneWay}"
                                                 ToolTip="{Binding PathError, Mode=OneWay}"
                                                 AutomationProperties.AutomationId="NewRepositoryPath">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPathError, Mode=OneWay}" Value="True">
                                                            <Setter Property="BorderBrush" Value="Red" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:RenamedDiscoveryRowViewModel}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CurrentArchiveFolder, Mode=OneWay, StringFormat='b) {0}'}" />
                                            <TextBlock Text="{Binding RenamedArchiveFolder, Mode=OneWay, StringFormat='a) {0}'}"
                                                       Visibility="{Binding CanChooseVariant, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:DiscoveryRowViewModel}">
                                        <Grid />
                                    </DataTemplate>
                                </ContentControl.Resources>
                            </ContentControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Details" Binding="{Binding Note, Mode=OneWay}" />
                <DataGridTextColumn Header="URL" Binding="{Binding Url, Mode=OneWay}" />
                <DataGridTextColumn Header="Owner" Binding="{Binding Owner, Mode=OneWay}" />
                <DataGridTextColumn Header="Visibility" Binding="{Binding Visibility, Mode=OneWay}" />
                <DataGridTextColumn Header="Fork" Binding="{Binding Fork, Mode=OneWay}" />
                <DataGridTextColumn Header="Archived" Binding="{Binding Archived, Mode=OneWay}" />
                <DataGridTextColumn Header="Default branch" Binding="{Binding DefaultBranch, Mode=OneWay}" />
                <DataGridTextColumn Header="Wiki" Binding="{Binding Wiki, Mode=OneWay}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
