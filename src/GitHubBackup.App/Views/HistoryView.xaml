<UserControl x:Class="GitHubBackup.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GitHubBackup.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="FilterControlStyle" TargetType="Control">
            <Setter Property="Margin" Value="0,0,12,4" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style x:Key="HistoryGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Firebrick" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Back"
                    Command="{Binding BackCommand, Mode=OneWay}"
                    Padding="8,2"
                    AutomationProperties.AutomationId="HistoryBackButton" />
        </StackPanel>
        <TabControl AutomationProperties.AutomationId="HistoryTabs">
            <TabItem Header="Runs" AutomationProperties.AutomationId="RunsTab">
                <DockPanel DataContext="{Binding Runs, Mode=OneWay}" Margin="4">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="From" Style="{StaticResource FilterLabelStyle}" />
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                    Style="{StaticResource FilterControlStyle}"
                                    AutomationProperties.AutomationId="HistoryFromDate" />
                        <TextBlock Text="To" Style="{StaticResource FilterLabelStyle}" />
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                    Style="{StaticResource FilterControlStyle}"
                                    AutomationProperties.AutomationId="HistoryToDate" />
                        <TextBlock Text="Status" Style="{StaticResource FilterLabelStyle}" />
                        <ComboBox ItemsSource="{x:Static vm:RunHistoryViewModel.StatusOptions}"
                                  SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource FilterControlStyle}"
                                  AutomationProperties.AutomationId="HistoryStatusFilter" />
                        <TextBlock Text="Mode" Style="{StaticResource FilterLabelStyle}" />
                        <ComboBox ItemsSource="{x:Static vm:RunHistoryViewModel.ModeOptions}"
                                  SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource FilterControlStyle}"
                                  AutomationProperties.AutomationId="HistoryModeFilter" />
                        <TextBlock Text="Dry run" Style="{StaticResource FilterLabelStyle}" />
                        <ComboBox ItemsSource="{x:Static vm:RunHistoryViewModel.DryRunOptions}"
                                  SelectedItem="{Binding SelectedDryRun, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource FilterControlStyle}"
                                  AutomationProperties.AutomationId="HistoryDryRunFilter" />
                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand, Mode=OneWay}"
                                Padding="8,2" Margin="0,0,0,4"
                                AutomationProperties.AutomationId="HistoryRefreshButton" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding FilterError, Mode=OneWay}"
                               Visibility="{Binding HasFilterError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Style="{StaticResource ErrorTextStyle}"
                               AutomationProperties.AutomationId="HistoryFilterError" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding LoadError, Mode=OneWay}"
                               Visibility="{Binding HasLoadError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Style="{StaticResource ErrorTextStyle}"
                               AutomationProperties.AutomationId="HistoryLoadError" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="{x:Static vm:RunHistoryViewModel.NoRunsMessage}"
                               Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Margin="0,0,0,8"
                               AutomationProperties.AutomationId="HistoryNoRuns" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="80" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" MinHeight="80" />
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding Runs, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                                  Style="{StaticResource HistoryGridStyle}"
                                  AutomationProperties.AutomationId="RunHistoryList">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Started" Binding="{Binding StartedAt, Mode=OneWay}" />
                                <DataGridTextColumn Header="Finished" Binding="{Binding FinishedAt, Mode=OneWay}" />
                                <DataGridTextColumn Header="Mode" Binding="{Binding Mode, Mode=OneWay}" />
                                <DataGridTextColumn Header="Dry run" Binding="{Binding DryRun, Mode=OneWay}" />
                                <DataGridTextColumn Header="Filter" Binding="{Binding Filter, Mode=OneWay}" />
                                <DataGridTextColumn Header="Exit code" Binding="{Binding ExitCode, Mode=OneWay}" />
                                <DataGridTextColumn Header="Items" Binding="{Binding Counts, Mode=OneWay}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" />
                        <Grid Grid.Row="2"
                              DataContext="{Binding SelectedRun, Mode=OneWay}"
                              Visibility="{Binding DataContext.HasSelectedRun, RelativeSource={RelativeSource AncestorType=DockPanel}, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="RunDetails">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,4,0,4">
                                <TextBlock AutomationProperties.AutomationId="RunDetailsTimes">
                                    <Run Text="{Binding StartedAt, Mode=OneWay}" />
                                    <Run Text="to" />
                                    <Run Text="{Binding FinishedAt, Mode=OneWay}" />
                                    <Run Text="{Binding Duration, Mode=OneWay, StringFormat='({0})'}" />
                                </TextBlock>
                                <TextBlock AutomationProperties.AutomationId="RunDetailsMode">
                                    <Run Text="{Binding Mode, Mode=OneWay, StringFormat='Mode: {0}'}" />
                                    <Run Text="{Binding DryRun, Mode=OneWay, StringFormat='  Dry run: {0}'}" />
                                    <Run Text="{Binding Filter, Mode=OneWay, StringFormat='  Filter: {0}'}" />
                                    <Run Text="{Binding ExitCode, Mode=OneWay, StringFormat='  Exit code: {0}'}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Counts, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="RunDetailsCounts" />
                            </StackPanel>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Items, Mode=OneWay}"
                                      Style="{StaticResource HistoryGridStyle}"
                                      AutomationProperties.AutomationId="RunDetailsItems">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Repository" Binding="{Binding Repository, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Target" Binding="{Binding Target, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Branch" Binding="{Binding Branch, Mode=OneWay}" />
                                    <DataGridTextColumn Header="HEAD" Binding="{Binding HeadCommit, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Archive" Binding="{Binding Archive, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Changed refs" Binding="{Binding ChangedRefs, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Error" Binding="{Binding Error, Mode=OneWay}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding DiscoveryEvents, Mode=OneWay}"
                                      Visibility="{Binding HasDiscoveryEvents, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      MaxHeight="140"
                                      Margin="0,8,0,0"
                                      Style="{StaticResource HistoryGridStyle}"
                                      AutomationProperties.AutomationId="RunDetailsDiscoveryEvents">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Event" Binding="{Binding Kind, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Repository" Binding="{Binding Repository, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Previous name" Binding="{Binding PreviousName, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Decision" Binding="{Binding Decision, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Decided by" Binding="{Binding DecidedBy, Mode=OneWay}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Archives" AutomationProperties.AutomationId="ArchivesTab">
                <DockPanel DataContext="{Binding Archives, Mode=OneWay}" Margin="4">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="Repository" Style="{StaticResource FilterLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Repositories, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedRepository, Mode=TwoWay}"
                                  DisplayMemberPath="FullName"
                                  MinWidth="240"
                                  Margin="0,0,12,4"
                                  AutomationProperties.AutomationId="ArchiveRepositoryList" />
                        <Button Content="Open folder"
                                Command="{Binding OpenFolderCommand, Mode=OneWay}"
                                Padding="8,2" Margin="0,0,8,4"
                                AutomationProperties.AutomationId="OpenArchiveFolderButton" />
                        <Button Content="Show in Explorer"
                                Command="{Binding ShowInExplorerCommand, Mode=OneWay}"
                                Padding="8,2" Margin="0,0,8,4"
                                AutomationProperties.AutomationId="ShowArchiveInExplorerButton" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding ArchiveFolder, Mode=OneWay, StringFormat='Folder: {0}'}"
                               Style="{StaticResource OptionalLineStyle}"
                               Margin="0,0,0,8"
                               AutomationProperties.AutomationId="ArchiveFolderPath" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding RepositoriesError, Mode=OneWay}"
                               Visibility="{Binding HasRepositoriesError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Style="{StaticResource ErrorTextStyle}"
                               AutomationProperties.AutomationId="ArchiveRepositoriesError" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding LoadError, Mode=OneWay}"
                               Visibility="{Binding HasLoadError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Style="{StaticResource ErrorTextStyle}"
                               AutomationProperties.AutomationId="ArchiveLoadError" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="{x:Static vm:ArchiveHistoryViewModel.NoArchivesMessage}"
                               Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Margin="0,0,0,8"
                               AutomationProperties.AutomationId="ArchiveNoArchives" />
                    <DataGrid ItemsSource="{Binding Archives, Mode=OneWay}"
                              SelectedItem="{Binding SelectedArchive, Mode=TwoWay}"
                              Style="{StaticResource HistoryGridStyle}"
                              AutomationProperties.AutomationId="ArchiveHistoryList">
                        <DataGrid.RowStyle>
                            <!-- An archive whose file is gone stays listed, so the gap in the history is visible. -->
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMissing, Mode=OneWay}" Value="True">
                                        <Setter Property="Foreground" Value="Firebrick" />
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, Mode=OneWay}" />
                            <DataGridTextColumn Header="Target" Binding="{Binding Target, Mode=OneWay}" />
                            <DataGridTextColumn Header="Archive" Binding="{Binding File, Mode=OneWay}" />
                            <DataGridTextColumn Header="File" Binding="{Binding FileState, Mode=OneWay}" />
                            <DataGridTextColumn Header="Branch" Binding="{Binding Branch, Mode=OneWay}" />
                            <DataGridTextColumn Header="Hash" Binding="{Binding ShortHash, Mode=OneWay}" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size, Mode=OneWay}" />
                            <DataGridTextColumn Header="Changed refs" Binding="{Binding ChangedRefs, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
