<UserControl x:Class="GitHubBackup.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GitHubBackup.App.ViewModels"
             xmlns:behaviors="clr-namespace:GitHubBackup.App.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="GroupStyle" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="RowButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="8,0,0,6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <!-- The mark of a section or an account with an error; UI Automation names it, because the glyph says nothing. -->
        <Style x:Key="ErrorIconStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE783;" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Foreground" Value="Firebrick" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="AutomationProperties.Name" Value="Has errors" />
        </Style>
        <Style x:Key="NoMatchStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="No repositories match the filter." />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- A table of repositories fills the rest of its section and scrolls on its own, so its virtualization works
             and the mouse wheel over it scrolls only the table. -->
        <ControlTemplate x:Key="ScrollingItemsTemplate" TargetType="ItemsControl">
            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>
        <ItemsPanelTemplate x:Key="VirtualizingPanelTemplate">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Save"
                    Command="{Binding SaveCommand, Mode=OneWay}"
                    Padding="8,2" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="SaveSettingsButton" />
            <Button Content="Cancel"
                    Command="{Binding CancelCommand, Mode=OneWay}"
                    Padding="8,2"
                    AutomationProperties.AutomationId="CancelSettingsButton" />
        </StackPanel>
        <ItemsControl DockPanel.Dock="Bottom"
                      ItemsSource="{Binding GeneralErrors, Mode=OneWay}"
                      Visibility="{Binding HasGeneralErrors, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Margin="0,8,0,0"
                      AutomationProperties.AutomationId="SettingsGeneralErrors">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Mode=OneWay, StringFormat='Error: {0}'}" Foreground="Firebrick" TextWrapping="Wrap" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding LoadError, Mode=OneWay}"
                   Visibility="{Binding HasLoadError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Foreground="Firebrick"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   AutomationProperties.AutomationId="SettingsLoadError" />
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding NewConfigMessage, Mode=OneWay}"
                   Visibility="{Binding IsNewConfig, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   AutomationProperties.AutomationId="SettingsNewConfigMessage" />
        <Border DockPanel.Dock="Top"
                Visibility="{Binding HasWarnings, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#33DAA520"
                BorderBrush="DarkGoldenrod"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding Warnings, Mode=OneWay}"
                          AutomationProperties.AutomationId="SettingsWarnings">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Mode=OneWay, StringFormat='Warning: {0}'}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Sections, Mode=OneTime}"
                     SelectedValuePath="Section"
                     SelectedValue="{Binding SelectedSection, Mode=TwoWay}"
                     MinWidth="170"
                     Margin="0,0,12,0"
                     VerticalAlignment="Top"
                     AutomationProperties.Name="Settings sections"
                     AutomationProperties.AutomationId="SettingsSectionList">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId, Mode=OneTime}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title, Mode=OneTime}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsSectionItem}">
                        <DockPanel>
                            <!-- The icon is decoration: the entry takes its UI Automation name from the title. -->
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding Glyph, Mode=OneTime}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock DockPanel.Dock="Right"
                                       Style="{StaticResource ErrorIconStyle}"
                                       Visibility="{Binding HasErrors, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="SettingsSectionErrorIcon" />
                            <TextBlock Text="{Binding Title, Mode=OneTime}" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Every section is built once and only hidden while another one is shown, so typed secrets and the
                 element bindings of the telemetry headers keep their state when the user switches sections. -->
            <GroupBox Grid.Column="1"
                      Header="General"
                      Style="{StaticResource GroupStyle}"
                      Visibility="{Binding GeneralSection.IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      AutomationProperties.AutomationId="SettingsGeneralGroup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <StackPanel IsEnabled="{Binding IsLoaded, Mode=OneWay}">
                            <TextBlock Text="Archive root folder" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding BackupRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     AutomationProperties.AutomationId="BackupRootBox" />
                            <TextBlock Text="Clone root folder (empty: the sources folder next to the application)" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding SourcesRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     AutomationProperties.AutomationId="SourcesRootBox" />
                            <TextBlock Text="Exclusion masks for every repository, separated by commas (owner/name or name, with * and ?)" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding Exclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     AutomationProperties.AutomationId="GlobalExcludeBox" />
                            <CheckBox Content="Offer repositories of owners that are not tracked accounts (discoverAccessibleRepositories)"
                                      IsChecked="{Binding DiscoverAccessibleRepositories, Mode=TwoWay}"
                                      Margin="0,4,0,0"
                                      AutomationProperties.AutomationId="DiscoverAccessibleRepositoriesCheckBox" />
                        </StackPanel>
                        <!-- The theme applies and is saved at once, so it stays available when backup-config.json cannot be read. -->
                        <TextBlock Text="Theme" Style="{StaticResource LabelStyle}" Margin="0,8,0,2" />
                        <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  HorizontalAlignment="Left"
                                  MinWidth="160"
                                  AutomationProperties.AutomationId="ThemeComboBox" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="Accounts"
                      Style="{StaticResource GroupStyle}"
                      IsEnabled="{Binding IsLoaded, Mode=OneWay}"
                      Visibility="{Binding AccountsSection.IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      AutomationProperties.AutomationId="SettingsAccountsGroup">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Add account"
                                    Command="{Binding AddAccountCommand, Mode=OneWay}"
                                    Padding="8,2"
                                    Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="AddAccountButton" />
                            <!-- The bindings to the selected account skip its validation errors: the account shows them at
                                 its own fields, and the default error frame would outline the list and the button. -->
                            <Button Content="Remove account"
                                    Command="{Binding RemoveAccountCommand, Mode=OneWay}"
                                    CommandParameter="{Binding SelectedAccount, Mode=OneWay, ValidatesOnNotifyDataErrors=False}"
                                    Visibility="{Binding HasSelectedAccount, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Padding="8,2"
                                    AutomationProperties.AutomationId="RemoveAccountButton" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Accounts, Mode=OneWay}"
                                 SelectedItem="{Binding SelectedAccount, Mode=TwoWay, ValidatesOnNotifyDataErrors=False}"
                                 AutomationProperties.Name="Accounts"
                                 AutomationProperties.AutomationId="AccountsList">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName, Mode=OneWay}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AccountSettingsViewModel}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{StaticResource ErrorIconStyle}"
                                                   Visibility="{Binding HasAnyErrors, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   AutomationProperties.AutomationId="AccountErrorIcon" />
                                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <TextBlock Grid.Column="1"
                               Text="No accounts. Add an account."
                               AutomationProperties.AutomationId="NoAccountsMessage">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedAccount, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Column="1"
                            Visibility="{Binding HasSelectedAccount, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid DataContext="{Binding SelectedAccount, Mode=OneWay, ValidatesOnNotifyDataErrors=False}"
                              AutomationProperties.AutomationId="AccountDetails">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Account URL (https://github.com/&lt;login&gt;)" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         AutomationProperties.AutomationId="AccountUrlBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Archive folder of the account (empty: backup root\owner)" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         AutomationProperties.AutomationId="AccountPathBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Exclusion masks of the account, separated by commas" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding Exclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         AutomationProperties.AutomationId="AccountExcludeBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Margin="0,6,0,0">
                                <TextBlock Text="Repositories: branch (empty: default) and archive folder (empty: derived from the account)" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Filter by name" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding RepositoryView.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Filter repositories by name"
                                             AutomationProperties.AutomationId="AccountRepositoryFilterBox" />
                                </DockPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="4"
                                       Style="{StaticResource NoMatchStyle}"
                                       Visibility="{Binding RepositoryView.HasNoMatch, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="AccountRepositoriesNoMatch" />
                            <ItemsControl Grid.Row="5"
                                          ItemsSource="{Binding RepositoryView.Items, Mode=OneWay}"
                                          Template="{StaticResource ScrollingItemsTemplate}"
                                          ItemsPanel="{StaticResource VirtualizingPanelTemplate}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          behaviors:ScrollToAddedItem.IsEnabled="True"
                                          AutomationProperties.AutomationId="AccountRepositoriesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AccountRepositorySettingsViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name, Mode=OneWay}" Margin="0,2,8,0" TextTrimming="CharacterEllipsis" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Branch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBoxStyle}"
                                                     AutomationProperties.AutomationId="AccountRepositoryBranchBox" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBoxStyle}"
                                                     Margin="8,0,0,6"
                                                     AutomationProperties.AutomationId="AccountRepositoryPathBox" />
                                            <Button Grid.Column="3"
                                                    Content="Remove"
                                                    Command="{Binding DataContext.RemoveRepositoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                                                    CommandParameter="{Binding Mode=OneWay}"
                                                    Style="{StaticResource RowButtonStyle}"
                                                    AutomationProperties.AutomationId="RemoveAccountRepositoryButton" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="Repositories"
                      Style="{StaticResource GroupStyle}"
                      IsEnabled="{Binding IsLoaded, Mode=OneWay}"
                      Visibility="{Binding RepositoriesSection.IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      AutomationProperties.AutomationId="SettingsRepositoriesGroup">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right"
                                Content="Add repository"
                                Command="{Binding AddRepositoryCommand, Mode=OneWay}"
                                Padding="8,2"
                                Margin="8,0,0,0"
                                AutomationProperties.AutomationId="AddRepositoryButton" />
                        <TextBlock Text="Standalone repositories: URL, branch (empty: default) and archive folder (empty: backup root\owner\repo)"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,6">
                        <TextBlock Text="Filter by URL" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding RepositoryView.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Filter repositories by URL"
                                 AutomationProperties.AutomationId="RepositoryFilterBox" />
                    </DockPanel>
                    <TextBlock Grid.Row="2"
                               Style="{StaticResource NoMatchStyle}"
                               Visibility="{Binding RepositoryView.HasNoMatch, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.AutomationId="RepositoriesNoMatch" />
                    <ItemsControl Grid.Row="3"
                                  ItemsSource="{Binding RepositoryView.Items, Mode=OneWay}"
                                  Template="{StaticResource ScrollingItemsTemplate}"
                                  ItemsPanel="{StaticResource VirtualizingPanelTemplate}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  behaviors:ScrollToAddedItem.IsEnabled="True"
                                  AutomationProperties.AutomationId="RepositoriesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RepositorySettingsViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             AutomationProperties.AutomationId="RepositoryUrlBox" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Branch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Margin="8,0,0,6"
                                             AutomationProperties.AutomationId="RepositoryBranchBox" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Margin="8,0,0,6"
                                             AutomationProperties.AutomationId="RepositoryPathBox" />
                                    <Button Grid.Column="3"
                                            Content="Remove"
                                            Command="{Binding DataContext.RemoveRepositoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                            CommandParameter="{Binding Mode=OneWay}"
                                            Style="{StaticResource RowButtonStyle}"
                                            AutomationProperties.AutomationId="RemoveRepositoryButton" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="Tools"
                      Style="{StaticResource GroupStyle}"
                      Visibility="{Binding ToolsSection.IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      AutomationProperties.AutomationId="SettingsToolsGroup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="The tool paths take effect after the application restarts." Style="{StaticResource LabelStyle}" Margin="0,0,0,6" />
                        <TextBlock Text="Path of git.exe (empty: git from PATH)" Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{Binding GitPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 AutomationProperties.AutomationId="GitPathBox" />
                        <TextBlock Text="Path of 7z.exe (empty: the default location)" Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{Binding SevenZipPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 AutomationProperties.AutomationId="SevenZipPathBox" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="Telemetry"
                      Style="{StaticResource GroupStyle}"
                      Visibility="{Binding TelemetrySection.IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      AutomationProperties.AutomationId="SettingsTelemetryGroup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Telemetry settings take effect after the application restarts." Style="{StaticResource LabelStyle}" Margin="0,0,0,6" />
                        <CheckBox Content="Send telemetry (OpenTelemetry)"
                                  IsChecked="{Binding TelemetryEnabled, Mode=TwoWay}"
                                  Margin="0,0,0,6"
                                  AutomationProperties.AutomationId="TelemetryEnabledCheckBox" />
                        <TextBlock Text="OTLP endpoint (gRPC), for example http://localhost:4317" Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{Binding OtlpEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 AutomationProperties.AutomationId="OtlpEndpointBox" />
                        <TextBlock Text="OTLP headers, for example api-key=&lt;license key&gt; (prefer the variable GitHubBackup__OpenTelemetry__Headers)"
                                   Style="{StaticResource LabelStyle}"
                                   TextWrapping="Wrap" />
                        <!-- The headers are a secret: the names and help texts of these elements are static text, never
                             a binding to the value, so UI Automation does not expose it while the value is hidden. -->
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right"
                                      Content="Show"
                                      IsChecked="{Binding IsTelemetryHeadersShown, Mode=TwoWay}"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Show OTLP headers"
                                      AutomationProperties.AutomationId="ShowTelemetryHeadersToggle" />
                            <Grid>
                                <PasswordBox behaviors:PasswordBoxBinding.Password="{Binding TelemetryHeaders, Mode=TwoWay}"
                                             Validation.ErrorTemplate="{x:Null}"
                                             AutomationProperties.Name="OTLP headers"
                                             AutomationProperties.AutomationId="TelemetryHeadersBox">
                                    <PasswordBox.Style>
                                        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTelemetryHeadersShown, Mode=OneWay}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </PasswordBox.Style>
                                </PasswordBox>
                                <TextBox x:Name="TelemetryHeadersTextBox"
                                         Text="{Binding TelemetryHeaders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Validation.ErrorTemplate="{x:Null}"
                                         AutomationProperties.Name="OTLP headers"
                                         AutomationProperties.AutomationId="TelemetryHeadersTextBox">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTelemetryHeadersShown, Mode=OneWay}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </DockPanel>
                        <!-- The error comes from the text box, which validates the same property while it is collapsed;
                             the current item of the error list is null when there is no error. -->
                        <TextBlock Text="{Binding ElementName=TelemetryHeadersTextBox, Path=(Validation.Errors)/ErrorContent, Mode=OneWay}"
                                   Style="{StaticResource OptionalLineStyle}"
                                   Foreground="Firebrick"
                                   AutomationProperties.AutomationId="TelemetryHeadersError" />
                        <TextBlock Text="{x:Static vm:SettingsViewModel.HeadersOverriddenMessage}"
                                   Visibility="{Binding IsTelemetryHeadersOverridden, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   AutomationProperties.AutomationId="TelemetryHeadersOverriddenNote" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Grid.Column="1"
                      Header="GitHub token"
                      Style="{StaticResource GroupStyle}"
                      Visibility="{Binding TokenSection.IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      AutomationProperties.AutomationId="SettingsTokenGroup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{Binding TokenStoreLocation, Mode=OneWay, StringFormat='The token is saved in {0}.'}"
                                   Style="{StaticResource LabelStyle}" />
                        <PasswordBox behaviors:PasswordBoxBinding.Password="{Binding Token, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="TokenBox" />
                        <TextBlock Text="{Binding TokenError, Mode=OneWay}"
                                   Style="{StaticResource OptionalLineStyle}"
                                   Foreground="Firebrick"
                                   AutomationProperties.AutomationId="TokenError" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Check token"
                                    Command="{Binding CheckTokenCommand, Mode=OneWay}"
                                    ToolTip="Checks the token in the field, or the token the application uses when the field is empty."
                                    Padding="8,2" Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="CheckTokenButton" />
                            <Button Content="Cancel check"
                                    Command="{Binding CheckTokenCancelCommand, Mode=OneWay}"
                                    Padding="8,2"
                                    AutomationProperties.AutomationId="CancelTokenCheckButton" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TokenCheckLines, Mode=OneWay}"
                                      Margin="0,6,0,0"
                                      AutomationProperties.AutomationId="TokenCheckResult" />
                        <TextBlock Text="{Binding TokenCheckError, Mode=OneWay}"
                                   Style="{StaticResource OptionalLineStyle}"
                                   Foreground="Firebrick"
                                   AutomationProperties.AutomationId="TokenCheckError" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
