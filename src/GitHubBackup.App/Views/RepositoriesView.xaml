<UserControl x:Class="GitHubBackup.App.Views.RepositoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:GitHubBackup.App.Controls"
             xmlns:vm="clr-namespace:GitHubBackup.App.ViewModels"
             xmlns:ui="clr-namespace:GitHubBackup.Core.Ui;assembly=GitHubBackup.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RepositoriesViewModel}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <!-- A splitter between two stacked cards: a transparent grip that is also the gap between the cards. -->
        <Style x:Key="SplitterThumbStyle" TargetType="Thumb">
            <Setter Property="Height" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Between the tree (star) and the live log (fixed), a grid splitter resizes only the log; the tree takes the rest. -->
        <Style x:Key="RowSplitterStyle" TargetType="GridSplitter" BasedOn="{StaticResource SplitterThumbStyle}">
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        </Style>
        <!-- The indent of a child node in the Fluent tree view item: the expander column of its parent. -->
        <GridLength x:Key="TreeChildIndent">19</GridLength>
        <!-- The width of one status slot; both slots keep it while empty, so the date column does not move. -->
        <GridLength x:Key="StatusSlotWidth">20</GridLength>
        <!-- The fixed width of the node name. The tree virtualizes its rows, so a width measured from the rows
             on screen would change while scrolling; a fixed width keeps the status and date columns in place. -->
        <GridLength x:Key="TreeNodeNameWidth">340</GridLength>
        <!-- The status column of a tree node, after the name. -->
        <Style x:Key="StatusColumnStyle" TargetType="Grid">
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <!-- A node of the tree: the selection and the expansion belong to the node of the ViewModel. -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName, Mode=OneWay}" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Backup all"
                    Command="{Binding StartBackupCommand, Mode=OneWay}"
                    CommandParameter="{x:Static vm:BackupScope.All}"
                    Padding="8,2" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="BackupAllButton" />
            <Button Content="Backup account"
                    Command="{Binding StartBackupCommand, Mode=OneWay}"
                    CommandParameter="{x:Static vm:BackupScope.Account}"
                    Padding="8,2" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="BackupAccountButton" />
            <Button Content="Backup repository"
                    Command="{Binding StartBackupCommand, Mode=OneWay}"
                    CommandParameter="{x:Static vm:BackupScope.Repository}"
                    Padding="8,2" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="BackupRepositoryButton" />
            <CheckBox Content="Dry run"
                      IsChecked="{Binding IsDryRun, Mode=TwoWay}"
                      IsEnabled="{Binding IsIdle, Mode=OneWay}"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      ToolTip="Back up nothing: the next run only shows what it would do."
                      AutomationProperties.AutomationId="DryRunToggle" />
            <Button Content="Cancel"
                    Command="{Binding StartBackupCancelCommand, Mode=OneWay}"
                    Padding="8,2" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="CancelBackupButton" />
            <Button Content="Settings"
                    Command="{Binding OpenSettingsCommand, Mode=OneWay}"
                    Padding="8,2" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="SettingsButton" />
            <Button Content="History"
                    Command="{Binding OpenHistoryCommand, Mode=OneWay}"
                    Padding="8,2" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="HistoryButton" />
            <TextBlock Text="Cancelling…"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="CancellingMessage">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding StartBackupCommand.IsRunning, Mode=OneWay}" Value="True" />
                                    <Condition Binding="{Binding StartBackupCommand.IsCancellationRequested, Mode=OneWay}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasProgress, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.AutomationId="RunProgress">
            <TextBlock Text="{Binding ProgressRepository, Mode=OneWay}"
                       FontWeight="SemiBold"
                       Margin="0,0,12,0"
                       AutomationProperties.AutomationId="RunProgressRepository" />
            <TextBlock Text="{Binding ProgressOperation, Mode=OneWay}"
                       AutomationProperties.AutomationId="RunProgressOperation" />
        </StackPanel>
        <Grid x:Name="PanelsGrid" LayoutUpdated="OnPanelsLayoutUpdated">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TreeRow" Height="*" MinHeight="60" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{Binding Layout.LogPanelHeight, Mode=TwoWay, Converter={StaticResource PixelGridLengthConverter}}"
                               MinHeight="{x:Static ui:UiSettings.MinLogPanelHeight}"
                               MaxHeight="{x:Static ui:UiSettings.MaxLogPanelHeight}" />
                <RowDefinition Height="Auto" />
                <!-- The results row takes no space until a run has a summary; its height is the saved summary height.
                     The code-behind lowers its maximum when the window has no room for it and the totals card. -->
                <RowDefinition x:Name="ResultsRow">
                    <RowDefinition.Height>
                        <MultiBinding Mode="TwoWay" Converter="{StaticResource OptionalRowHeightConverter}">
                            <Binding Path="Layout.SummaryPanelHeight" Mode="TwoWay" />
                            <Binding Path="HasSummary" Mode="OneWay" />
                        </MultiBinding>
                    </RowDefinition.Height>
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="MinHeight" Value="{x:Static ui:UiSettings.MinSummaryPanelHeight}" />
                            <Setter Property="MaxHeight" Value="{x:Static ui:UiSettings.MaxSummaryPanelHeight}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSummary, Mode=OneWay}" Value="False">
                                    <Setter Property="MinHeight" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:CardPanel Grid.Row="0"
                                Style="{StaticResource PanelCardStyle}"
                                AutomationProperties.AutomationId="RepositoryTreePanel">
                <Grid>
                    <TreeView ItemsSource="{Binding Nodes, Mode=OneWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource TreeItemStyle}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              AutomationProperties.AutomationId="RepositoryTree">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:AccountNodeViewModel}"
                                                      ItemsSource="{Binding Children, Mode=OneWay}"
                                                      ItemContainerStyle="{StaticResource TreeItemStyle}">
                                <!-- The name has the fixed width of the repository names, and the spacer after it has the
                                     indent of a child node, so the status of the account lines up with the status of
                                     the repositories one level deeper. -->
                                <Grid Style="{StaticResource TreeNodeRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{StaticResource TreeNodeNameWidth}" />
                                        <ColumnDefinition Width="{StaticResource TreeChildIndent}" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{StaticResource AccountNodeGlyph}"
                                               Style="{StaticResource TreeNodeIconStyle}"
                                               AutomationProperties.Name="Account"
                                               AutomationProperties.AutomationId="AccountNodeIcon" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.AutomationId="AccountNameText" />
                                    <Grid Grid.Column="3" Style="{StaticResource StatusColumnStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource StatusSlotWidth}" />
                                            <ColumnDefinition Width="{StaticResource StatusSlotWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource PrimaryStatusIconStyle}"
                                                   AutomationProperties.AutomationId="AccountStatusIcon" />
                                    </Grid>
                                </Grid>
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:RepositoryGroupNodeViewModel}"
                                                      ItemsSource="{Binding Children, Mode=OneWay}"
                                                      ItemContainerStyle="{StaticResource TreeItemStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource RepositoryGroupNodeGlyph}"
                                               Style="{StaticResource TreeNodeIconStyle}"
                                               AutomationProperties.Name="Repository group"
                                               AutomationProperties.AutomationId="RepositoryGroupNodeIcon" />
                                    <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type vm:RepositoryNodeViewModel}">
                                <!-- The name has a fixed width, so the columns line up across the accounts and the group of
                                     standalone repositories whichever rows are on screen. The icon column and the two status
                                     slots have fixed widths too; a name wider than its column ends with an ellipsis. -->
                                <Grid Style="{StaticResource TreeNodeRowStyle}" ToolTip="{Binding StateError, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="{StaticResource TreeNodeNameWidth}" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{StaticResource RepositoryNodeGlyph}"
                                               Style="{StaticResource TreeNodeIconStyle}"
                                               AutomationProperties.Name="Repository"
                                               AutomationProperties.AutomationId="RepositoryNodeIcon" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.AutomationId="RepositoryNameText" />
                                    <Grid Grid.Column="2" Style="{StaticResource StatusColumnStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource StatusSlotWidth}" />
                                            <ColumnDefinition Width="{StaticResource StatusSlotWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource PrimaryStatusIconStyle}"
                                                   AutomationProperties.AutomationId="RepositoryStatusIcon" />
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource UnavailableStatusIconStyle}"
                                                   AutomationProperties.AutomationId="RepositoryUnavailableIcon" />
                                    </Grid>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding LastArchiveText, Mode=OneWay}"
                                               Margin="12,0,0,0"
                                               AutomationProperties.AutomationId="RepositoryLastArchiveText" />
                                </Grid>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    <TextBlock Text="{Binding LoadError, Mode=OneWay}"
                               Visibility="{Binding HasLoadError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                               Foreground="Firebrick"
                               Padding="8"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="TreeLoadError" />
                    <TextBlock Text="backup-config.json lists no accounts and no repositories."
                               Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="EmptyTreeMessage" />
                    <StackPanel Visibility="{Binding IsConfigMissing, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Static vm:RepositoriesViewModel.ConfigMissingMessage}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"
                                   AutomationProperties.AutomationId="ConfigMissingMessage" />
                        <Button Content="Open settings"
                                Command="{Binding OpenSettingsCommand, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                Padding="8,2"
                                AutomationProperties.AutomationId="OpenSettingsFromFirstRunButton" />
                    </StackPanel>
                </Grid>
            </controls:CardPanel>
            <GridSplitter Grid.Row="1"
                          Style="{StaticResource RowSplitterStyle}"
                          AutomationProperties.AutomationId="TreeLogSplitter" />
            <controls:CardPanel Grid.Row="2"
                                Style="{StaticResource PanelCardStyle}"
                                AutomationProperties.AutomationId="RunLogPanel">
                <Grid>
                    <ListBox x:Name="RunLogList"
                             ItemsSource="{Binding RunLog.Entries, Mode=OneWay}"
                             Style="{StaticResource CardListBoxStyle}"
                             FontFamily="Consolas"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource CompactListBoxItemStyle}"
                             AutomationProperties.AutomationId="RunLog">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Timestamp, Mode=OneWay, StringFormat='HH:mm:ss'}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Level, Mode=OneWay}" MinWidth="80" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Message, Mode=OneWay}" />
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level, Mode=OneWay}" Value="Warning">
                                                    <Setter Property="TextElement.Foreground" Value="DarkGoldenrod" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level, Mode=OneWay}" Value="Error">
                                                    <Setter Property="TextElement.Foreground" Value="Firebrick" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level, Mode=OneWay}" Value="Critical">
                                                    <Setter Property="TextElement.Foreground" Value="Firebrick" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- The button lies over the list, so it takes no row of the panel; its right margin keeps the room of
                         the vertical scroll bar free at all times, so the button neither covers the bar nor moves when the
                         bar appears. -->
                    <Button Content="&#xE894;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Padding="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,0,18,0"
                            Command="{Binding RunLog.ClearCommand, Mode=OneWay}"
                            ToolTip="Clear log"
                            AutomationProperties.Name="Clear log"
                            AutomationProperties.AutomationId="ClearRunLogButton" />
                </Grid>
            </controls:CardPanel>
            <!-- A grid splitter between two fixed rows would resize only the upper one, the live log; this splitter
                 resizes the results panel below it instead, and the tree takes the rest. -->
            <Thumb Grid.Row="3"
                   Style="{StaticResource SplitterThumbStyle}"
                   Visibility="{Binding HasSummary, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                   DragDelta="OnLogResultsSplitterDragDelta"
                   AutomationProperties.AutomationId="LogSummarySplitter" />
            <controls:CardPanel x:Name="ResultsCard"
                                Grid.Row="4"
                                Style="{StaticResource PanelCardStyle}"
                                Visibility="{Binding HasSummary, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="RunResultsPanel">
                <!-- The result table takes the height the splitter gives the panel and scrolls inside it; the lines
                     above and below it keep their natural height. The table never shrinks below its header and one
                     row: when the card is lower than that, the whole card scrolls instead of cutting text. -->
                <ScrollViewer x:Name="ResultsScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              AutomationProperties.AutomationId="RunResultsScroll">
                    <Grid x:Name="ResultsContent"
                          DataContext="{Binding Summary, Mode=OneWay}"
                          Height="{Binding ViewportHeight, ElementName=ResultsScroll, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="ResultsTableRow" Height="*">
                                <RowDefinition.Style>
                                    <Style TargetType="RowDefinition">
                                        <Setter Property="MinHeight" Value="56" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, Mode=OneWay}" Value="False">
                                                <Setter Property="MinHeight" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RowDefinition.Style>
                            </RowDefinition>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,4" SizeChanged="OnResultsPartSizeChanged">
                            <TextBlock Text="{Binding Header, Mode=OneWay}"
                                       Style="{StaticResource OptionalLineStyle}"
                                       AutomationProperties.AutomationId="RunSummaryHeader" />
                            <ItemsControl ItemsSource="{Binding Errors, Mode=OneWay}"
                                          Visibility="{Binding HasErrors, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          AutomationProperties.AutomationId="RunSummaryErrors">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Mode=OneWay, StringFormat='Error: {0}'}"
                                                   Foreground="Firebrick"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Warnings, Mode=OneWay}"
                                          Visibility="{Binding HasWarnings, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          AutomationProperties.AutomationId="RunSummaryWarnings">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Mode=OneWay, StringFormat='Warning: {0}'}"
                                                   Foreground="DarkGoldenrod"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- The line sets the table apart from the header and the error lines above it. -->
                        <Border Grid.Row="1"
                                Height="1"
                                Margin="0,0,0,6"
                                Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                Visibility="{Binding HasItems, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                SizeChanged="OnResultsPartSizeChanged" />
                        <ListView Grid.Row="2"
                                  ItemsSource="{Binding Rows, Mode=OneWay}"
                                  Visibility="{Binding HasItems, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ItemContainerStyle="{StaticResource CompactListViewItemStyle}"
                                  AutomationProperties.AutomationId="RunSummaryTable">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Repository" DisplayMemberBinding="{Binding Repository, Mode=OneWay}" />
                                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status, Mode=OneWay}" />
                                    <GridViewColumn Header="Archive" DisplayMemberBinding="{Binding Archive, Mode=OneWay}" />
                                    <GridViewColumn Header="Duration" DisplayMemberBinding="{Binding Duration, Mode=OneWay}" />
                                    <GridViewColumn Header="Error" DisplayMemberBinding="{Binding Error, Mode=OneWay}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel Grid.Row="3" SizeChanged="OnResultsPartSizeChanged">
                            <TextBlock Text="{Binding NoRepositoriesLine, Mode=OneWay}"
                                       Style="{StaticResource OptionalLineStyle}"
                                       AutomationProperties.AutomationId="RunSummaryNoRepositories" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </controls:CardPanel>
            <!-- The totals card takes the height of its content and has no splitter; the margin is the gap to the
                 results card and goes away with the card when there is no summary. -->
            <controls:CardPanel Grid.Row="5"
                                Margin="0,8,0,0"
                                Style="{StaticResource PanelCardStyle}"
                                Visibility="{Binding HasSummary, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="RunTotalsPanel">
                <StackPanel DataContext="{Binding Summary, Mode=OneWay}">
                    <ItemsControl ItemsSource="{Binding DiscoveryLines, Mode=OneWay}"
                                  Visibility="{Binding HasDiscoveryLines, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  MaxHeight="160"
                                  AutomationProperties.AutomationId="RunSummaryDiscovery">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControl>
                    <TextBlock Text="{Binding CancelledLine, Mode=OneWay}"
                               Style="{StaticResource OptionalLineStyle}"
                               Foreground="DarkGoldenrod"
                               AutomationProperties.AutomationId="RunSummaryCancelled" />
                    <TextBlock Text="{Binding TotalsLine, Mode=OneWay}"
                               Style="{StaticResource OptionalLineStyle}"
                               AutomationProperties.AutomationId="RunSummaryTotals" />
                    <TextBlock Text="{Binding LogPath, Mode=OneWay, StringFormat='Log: {0}'}"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="RunSummaryLogPath" />
                </StackPanel>
            </controls:CardPanel>
        </Grid>
    </DockPanel>
</UserControl>
