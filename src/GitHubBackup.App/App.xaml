<Application x:Class="GitHubBackup.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GitHubBackup.App.ViewModels"
             xmlns:views="clr-namespace:GitHubBackup.App.Views"
             xmlns:converters="clr-namespace:GitHubBackup.App.Converters"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="System">
    <!-- The application shuts down explicitly, after the host has stopped asynchronously when the main window closes.
         The Fluent theme is loaded before the resources below, so their BasedOn finds the Fluent styles; the theme
         service then switches the mode chosen by the user. -->
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:PixelGridLengthConverter x:Key="PixelGridLengthConverter" />
        <converters:OptionalRowHeightConverter x:Key="OptionalRowHeightConverter" />
        <!-- A text block without text takes no space, so optional lines of a panel leave no gap. -->
        <Style x:Key="OptionalLineStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A style of a control extends the Fluent style of that control: a style without BasedOn replaces it and
             falls back to the classic template, which stays light in the dark theme. -->
        <!-- A row of a list that shows one line of text per item keeps the height of that line. -->
        <Style x:Key="CompactListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- A list view with a grid view takes its row style from the grid view key, not from the ListViewItem type. -->
        <Style x:Key="CompactListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- A text box of a form shows its validation errors below itself; the larger bottom margin keeps the error
             text from covering the next field. -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <Border BorderBrush="Firebrick" BorderThickness="1">
                                <AdornedElementPlaceholder x:Name="Placeholder" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding ElementName=Placeholder, Path=AdornedElement.(Validation.Errors), Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ErrorContent, Mode=OneWay}" Foreground="Firebrick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Margin" Value="0,0,0,24" />
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent, Mode=OneWay}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type vm:RepositoriesViewModel}">
            <views:RepositoriesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
    </Application.Resources>
</Application>
