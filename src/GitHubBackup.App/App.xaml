<Application x:Class="GitHubBackup.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:GitHubBackup.App.ViewModels"
             xmlns:views="clr-namespace:GitHubBackup.App.Views"
             xmlns:converters="clr-namespace:GitHubBackup.App.Converters"
             xmlns:controls="clr-namespace:GitHubBackup.App.Controls"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="System">
    <!-- The application shuts down explicitly, after the host has stopped asynchronously when the main window closes.
         The Fluent theme is loaded before the resources below, so their BasedOn finds the Fluent styles; the theme
         service then switches the mode chosen by the user. -->
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:PixelGridLengthConverter x:Key="PixelGridLengthConverter" />
        <converters:OptionalRowHeightConverter x:Key="OptionalRowHeightConverter" />
        <!-- A panel of the main window: a card set apart from the window and from the other panels. -->
        <Style x:Key="PanelCardStyle" TargetType="controls:CardPanel">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <!-- The glyphs of the tree node kinds, each in one place; the font is the one of the settings sections. -->
        <sys:String x:Key="AccountNodeGlyph">&#xE77B;</sys:String>
        <sys:String x:Key="RepositoryGroupNodeGlyph">&#xE8F1;</sys:String>
        <sys:String x:Key="RepositoryNodeGlyph">&#xE8B7;</sys:String>
        <!-- The icon in front of a tree node: one width for every kind, the color of the node text. -->
        <Style x:Key="TreeNodeIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The glyphs of the status icons of the tree. -->
        <sys:String x:Key="ActiveStatusGlyph">&#xE73E;</sys:String>
        <sys:String x:Key="PausedStatusGlyph">&#xE769;</sys:String>
        <sys:String x:Key="UnavailableStatusGlyph">&#xE733;</sys:String>
        <sys:String x:Key="ExcludedStatusGlyph">&#xE738;</sys:String>
        <!-- A status icon of a tree node: the status name of the node is its tooltip and its UI Automation name. -->
        <Style x:Key="StatusIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding StatusName, Mode=OneWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding StatusName, Mode=OneWay}" />
        </Style>
        <!-- The first status slot: the check of a node an unfiltered run backs up, the pause, or the minus of an
             excluded repository; the node shows at most one of them. -->
        <Style x:Key="PrimaryStatusIconStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusIconStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowsActiveIcon, Mode=OneWay}" Value="True">
                    <Setter Property="Text" Value="{StaticResource ActiveStatusGlyph}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowsPausedIcon, Mode=OneWay}" Value="True">
                    <Setter Property="Text" Value="{StaticResource PausedStatusGlyph}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowsExcludedIcon, Mode=OneWay}" Value="True">
                    <Setter Property="Text" Value="{StaticResource ExcludedStatusGlyph}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The second status slot: the icon of an unavailable repository, in the status color of a warning. -->
        <Style x:Key="UnavailableStatusIconStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusIconStyle}">
            <Setter Property="Text" Value="{StaticResource UnavailableStatusGlyph}" />
            <Setter Property="Foreground" Value="DarkGoldenrod" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowsUnavailableIcon, Mode=OneWay}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The text of a tree node: muted while the node or its account is paused. -->
        <Style x:Key="TreeNodeRowStyle" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMuted, Mode=OneWay}" Value="True">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A text block without text takes no space, so optional lines of a panel leave no gap. -->
        <Style x:Key="OptionalLineStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The frame of a message the user must not miss, such as a warning or a setting that needs a restart; the
             translucent fill keeps the text readable in the light and the dark theme. -->
        <Style x:Key="NoticeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#33DAA520" />
            <Setter Property="BorderBrush" Value="DarkGoldenrod" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- A static notice with a warning glyph in the notice frame; the content is the text of the notice. A label
             exposes that text as its UI Automation name; the theme brush keeps the text readable in the dark theme. -->
        <Style x:Key="NoticeStyle" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <Border Style="{StaticResource NoticeBorderStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left"
                                           Text="&#xE7BA;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="DarkGoldenrod"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           AutomationProperties.Name="Important" />
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A selected data grid row takes a translucent accent fill and keeps the primary text color, so it reads
             like a selected list item; the Fluent default fills it with a pale accent and dark text, which stands out
             harshly in the dark theme. -->
        <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush"
                         Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}"
                         Opacity="0.35" />
        <SolidColorBrush x:Key="DataGridRowSelectedForegroundThemeBrush"
                         Color="{DynamicResource TextFillColorPrimary}" />
        <!-- A style of a control extends the Fluent style of that control: a style without BasedOn replaces it and
             falls back to the classic template, which stays light in the dark theme. -->
        <!-- A row of a list that shows one line of text per item keeps the height of that line. -->
        <Style x:Key="CompactListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- A list view with a grid view takes its row style from the grid view key, not from the ListViewItem type. -->
        <Style x:Key="CompactListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- A text box of a form shows its validation errors below itself; the larger bottom margin keeps the error
             text from covering the next field. -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <StackPanel>
                            <Border BorderBrush="Firebrick" BorderThickness="1">
                                <AdornedElementPlaceholder x:Name="Placeholder" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding ElementName=Placeholder, Path=AdornedElement.(Validation.Errors), Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ErrorContent, Mode=OneWay}" Foreground="Firebrick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="Margin" Value="0,0,0,24" />
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent, Mode=OneWay}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type vm:RepositoriesViewModel}">
            <views:RepositoriesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
    </Application.Resources>
</Application>
