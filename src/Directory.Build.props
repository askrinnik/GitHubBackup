<Project>
  <PropertyGroup>
    <!-- Core stays OS-independent; every project that references Infrastructure inherits its Windows target. -->
    <IsOsIndependentProject Condition="'$(MSBuildProjectName)' == 'GitHubBackup.Core' or '$(MSBuildProjectName)' == 'GitHubBackup.Core.Tests'">true</IsOsIndependentProject>
    <TargetFramework Condition="'$(IsOsIndependentProject)' == 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(IsOsIndependentProject)' != 'true'">net10.0-windows</TargetFramework>

    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Selected by name: IsTestProject is not yet set when Directory.Build.props is evaluated. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Test methods are documented by their Method_Scenario_ExpectedResult names, so a missing XML comment is not an error. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
