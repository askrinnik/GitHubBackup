<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The suite drives the running WPF app, so a plain solution test run skips it and a project that runs zero tests can
    fail CI. Build with -p:RunUITests=true to include it, as ui-smoke-tests.yml does.
  -->
  <PropertyGroup Condition="'$(RunUITests)' != 'true'">
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitHubBackup.App\GitHubBackup.App.csproj" />
    <ProjectReference Include="..\GitHubBackup.TestUtilities\GitHubBackup.TestUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests copy the output folder of the WPF project and start its executable from the copy. -->
    <AssemblyMetadata Include="GitHubBackupAppOutputPath" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\GitHubBackup.App\bin\$(Configuration)\$(TargetFramework)'))" />
  </ItemGroup>

</Project>
