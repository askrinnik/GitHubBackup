{
  "baseBranch": "main",
  "workItemPattern": ["^(\\d+)-", "^#(\\d+)"],
  "workItemCommandPattern": "/issue-kit:implement-issues?",
  "lanePlanGlob": "docs/plans/*-{id}-*.md",
  "excludeSessionManifests": [".ai/benchmarks/harness/runs"],
  "activityRules": [
    { "pattern": "^Agent:issue-kit:skill-runner|^Skill:issue-kit:(git-commit|open-pr|github-issue)", "category": "ship" },
    { "pattern": "^Bash:(?!.*git (commit|push)).*(UITests|Category=(UI|Smoke))", "category": "e2e" },
    { "pattern": "^Agent:issue-kit:build-runner", "category": "build/test" },
    { "pattern": "^Agent:issue-kit:issue-developer", "category": "implement" },
    { "pattern": "^Write:.*docs.plans|^Agent:(issue-kit:issue-planner|architect)", "category": "plan" },
    { "pattern": "^Agent:security-reviewer|^Skill:(code-review|security-review)", "category": "review" }
  ]
}
